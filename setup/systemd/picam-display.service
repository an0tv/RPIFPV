# Fullscreen local camera preview on the attached screen (mpv via DRM/KMS).
# install.sh substitutes the @...@ placeholders.
[Unit]
Description=PiCam local display (fullscreen camera)
After=multi-user.target

[Service]
Type=simple
User=root
ExecStart=@INSTALL_DIR@/display.sh
Restart=always
RestartSec=3
Environment=VIDEO_DEVICE=@VIDEO_DEVICE@
Environment=VIDEO_SIZE=@VIDEO_SIZE@
Environment=VIDEO_FPS=@VIDEO_FPS@
# Set DISPLAY_CONNECTOR if autodetect picks the wrong output (e.g. HDMI-A-1, DSI-1)
#Environment=DISPLAY_CONNECTOR=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
