# Wi-Fi supervisor: keeps the Pi reachable (client network or fallback AP).
[Unit]
Description=PiCam Wi-Fi supervisor (client / fallback AP)
After=NetworkManager.service network-online.target
Wants=NetworkManager.service
Before=picam-camera.service

[Service]
Type=simple
ExecStart=/opt/picam/netd.sh
Restart=always
RestartSec=3
# mode can be changed live via the web UI (writes wifi.json); no restart needed
Environment=LOOP_INTERVAL=5
Environment=AP_FALLBACK=20
Environment=STA_RETRY=60
Environment=STA_CONNECT_TIMEOUT=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
