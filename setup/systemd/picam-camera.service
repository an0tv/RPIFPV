# go2rtc streaming daemon (captures the UVC dongle, serves WebRTC/MSE).
[Unit]
Description=go2rtc camera stream
After=network-online.target picam-net.service
Wants=network-online.target
RequiresMountsFor=/opt/picam

[Service]
Type=simple
User=picam
Group=video
WorkingDirectory=/opt/picam
ExecStart=/opt/picam/go2rtc -config /etc/picam/go2rtc.yaml
Restart=always
RestartSec=3
# keep logging bounded
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
