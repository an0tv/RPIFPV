# OpenIPC portal — web UI + config API on :8080
[Unit]
Description=OpenIPC web portal (stream view + wifi config)
After=network-online.target openipc-net.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/openipc/web/portal.py
Restart=always
RestartSec=3
Environment=PORT=8080

[Install]
WantedBy=multi-user.target
