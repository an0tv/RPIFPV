# go2rtc streaming daemon (captures the UVC dongle, serves WebRTC/MSE).
[Unit]
Description=go2rtc camera stream
After=network-online.target openipc-net.service
Wants=network-online.target
RequiresMountsFor=/opt/openipc

[Service]
Type=simple
User=openipc
Group=video
WorkingDirectory=/opt/openipc
ExecStart=/opt/openipc/go2rtc -config /etc/openipc/go2rtc.yaml
Restart=always
RestartSec=3
# keep logging bounded
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
